# Gemini Web Proxy - Variables de Entorno (Plantilla)
# Copia este archivo como .env y completa tus credenciales personales.
# NUNCA compartas tu archivo .env ni lo subas a repositorios públicos.

# 1. Sesión Web de Gemini 4 Argon (Google AI Pro)
# Obtenidas desde https://gemini.google.com con F12 -> Application -> Cookies
GEMINI_PSID="tu-__Secure-1PSID-aqui"
GEMINI_PSIDTS="tu-__Secure-1PSIDTS-aqui"

# 2. Gemini Developer API Key (para Las Manos / Function Calling a Temp 0)
# Obtenida gratis en https://aistudio.google.com/app/apikey
GEMINI_API_KEY="tu-gemini-api-key-aqui"

# 3. Configuración del Servidor Local
PORT=3000
